@Library('jenkins')_

node(params.ENVIRONMENT) {
    stage('Deploy') {
        checkout scm
        withCredentials([
            usernamePassword(
                credentialsId: 'docker-registry',
                usernameVariable: 'USER',
                passwordVariable: 'PASSWORD'
            )
        ]) {
            withEnv(["VERSION=${params.IMAGE_TAG}"]) {
                sh """docker login -u ${USER} -p ${PASSWORD}
                docker compose down
                docker compose up -d
                docker logout"""
            }
        }
    smokeTest(
        port: params.port ?: 8000,
        serviceName: 'currency',
        version: '0.1.0'
    )
    }
}
